<div class="column-fixed" id="col1">
  <div class="portlet" id="studylib_cover_image">
    <h2 class="title"><%= t("studylib.settings.cover_image") %></h2>
    <div class="config_box">
      <% if notice.present? %>
        <p id="notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p role="alert"><%= alert %></p>
      <% end %>

      <ul>
        <li>
          <%= form_with scope: :settings, url: studylib_settings_path, method: :patch, local: true do %>
            <%= label_tag "google_books_api_key", t("studylib.settings.google_books_api_key"), style: "font-weight: normal" %>
            （<%= @google_books_key_configured ? t("studylib.settings.configured") : t("studylib.settings.not_configured") %>）
            <br/>
            <%= password_field_tag "settings[google_books_api_key]", nil,
                  id: "google_books_api_key", autocomplete: "new-password", size: 48 %>
            <p><%= t("studylib.settings.key_help") %></p>

            <% if @google_books_key_configured %>
              <%= check_box_tag "settings[remove_google_books_api_key]", "1", false, id: "remove_google_books_api_key" %>
              <%= label_tag "remove_google_books_api_key", t("studylib.settings.remove_key") %>
              <br/>
            <% end %>

            <%= submit_tag t("studylib.settings.save") %>
          <% end %>
        </li>
        <li>
          <%= t("studylib.settings.current_setting") %>
          <%= link_to t("studylib.settings.library_group_link"), library_group_path(@library_group) %>
        </li>
      </ul>
    </div>
  </div>
</div>
